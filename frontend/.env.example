# Backend API URL for production deployment.
# Leave empty for local development (Vite proxies /api and /ws to localhost:8080).
# On Vercel this MUST be the public Render URL, including https, with no trailing slash.
# Duo raid positions and voice both ride this server's websocket, so two players
# on different networks do not need a TURN server.
VITE_API_BASE_URL=https://your-backend-url.onrender.com
